# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SOLO servidor. Nunca prefijar con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Solo para los scripts locales (migraciones, verificación, limpieza); NO se necesita en Vercel. Supabase → Connect → Direct connection
DATABASE_URL=

# Google Calendar (solo servidor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# WhatsApp (solo dígitos con código de país, ej. 18095550000)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Dirección pública de la web (en producción, el dominio real; se usa para SEO, sitemap y enlaces)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: solo si el proyecto de Supabase NO tiene pg_cron; protege /api/cron/reminders (genera avisos internos)
CRON_SECRET=
